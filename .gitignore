# What compiler.py and PyInstaller leave behind
build/
dist/
*.spec

# Python
__pycache__/
*.py[cod]

# Tools and editors
.claude/
.venv/
venv/
.vscode/
.idea/

# Logs and crash reports, wherever they are run from
*.log
crash.txt

# Windows
Thumbs.db
desktop.ini

# the page the build makes from README.md; a manual run of tools/md_to_html.py can land it here
readme.html

# macOS
.DS_Store

# Building OpenAL Soft for the Mac (tools/build_openal_mac.sh): the source and the build, never committed
vendor/build-openal/

# A language being written: tools/make_language.py writes it, its author renames it when it is ready
localization/template.json

# Android (android/): Gradle's and Android Studio's own files (its build/ folders are build/ above), any APK,
# and what android/app/build.gradle copies in before each build from the repository's own audiodefence,
# game, assets/hrtf, localization and VERSION - never committed, one copy each
android/.gradle/
android/local.properties
android/**/*.apk
android/app/src/main/python/
android/app/src/main/assets/
